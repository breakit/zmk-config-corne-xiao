/*
 * Positional key definitions for the Corne Xiao v1 (42 keys).
 *
 * The Corne Xiao v1 matrix has the exact same physical switch positions as the
 * 6-column split used by the shared Townk-style layout, so the 0..41 position
 * numbering here matches the `corne_xiao_6col_posmap` position map for this
 * shield.
 *
 * The positional syntax:
 *   ╭───── Side: L | R
 *   │ ╭─── Row:   T (top) | M (middle/home) | B (bottom) | F (footer/thumb)
 *   │ │ ╭─ Column: 0..5 from the inside out, or C for a cluster-outside key
 * ╭─┴─┴─┴─╮
 * │ L T 0 │
 * ╰─┬─┬─┬─╯
 */

#pragma once

#define LT0  5  // left-top row
#define LT1  4
#define LT2  3
#define LT3  2
#define LT4  1
#define LT5  0

#define RT0  6  // right-top row
#define RT1  7
#define RT2  8
#define RT3  9
#define RT4 10
#define RT5 11

#define LM0 17  // left-middle row
#define LM1 16
#define LM2 15
#define LM3 14
#define LM4 13
#define LM5 12

#define RM0 18  // right-middle row
#define RM1 19
#define RM2 20
#define RM3 21
#define RM4 22
#define RM5 23

#define LB0 29  // left-bottom row
#define LB1 28
#define LB2 27
#define LB3 26
#define LB4 25
#define LB5 24

#define RB0 30  // right-bottom row
#define RB1 31
#define RB2 32
#define RB3 33
#define RB4 34
#define RB5 35

#define LF0 38  // left thumb keys
#define LF1 37
#define LF2 36

#define RF0 39  // right thumb keys
#define RF1 40
#define RF2 41


// All keys on the left side of the keyboard excluding thumb keys
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5

// All keys on the right side of the keyboard excluding thumb keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5

// Thumb cluster keys from the left side of the keyboard
#define THUMB_L LF2 LF1 LF0

// Thumb cluster keys from the right side of the keyboard
#define THUMB_R RF0 RF1 RF2

// All thumb cluster keys
#define THUMBS THUMB_L THUMB_R
