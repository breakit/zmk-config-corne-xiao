#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };
};

#define L_QWT 0
#define L_NAV 1
#define L_NUM 2
#define L_SYM 3
#define L_MED 4
#define L_FUN 5
#define L_BUT 6
#define L_SYS 7

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T     &kp Y &kp U &kp I &kp O &kp P &kp MINUS
   &kp GRAVE &mt LSHFT A &mt LCTRL S &mt LALT D &mt LGUI F &kp G   &kp H &mt RGUI J &mt RALT K &mt RCTRL L &kp SEMI &kp SQT
   &kp BSLH  &kp Z &kp X &kp C &kp V &kp B     &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp EQUAL
                        &mo L_SYS &mo L_SYM &mo L_NUM     &kp SPACE &mo L_NAV &mo L_MED
                        >;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
   &trans &none &none &none &none &none     &none &kp BTAB &none &none &kp TAB &none
   &trans &none &none &none &none &none     &none &none &kp HOME &kp PG_DN &kp PG_UP &kp END
   &trans &none &none &none &none &kp LG(B) &none &kp LEFT &kp DOWN &kp UP &kp RIGHT &none
                   &none &none &tog L_NAV     &none &kp BSPC &none
                        >;
        };

        num_layer {
            display-name = "Numbers";
            bindings = <
   &none &kp LBKT &kp STAR &kp FSLH &kp RBKT &kp CARET      &none &none &none &none &none &none
   &kp TAB &kp N1 &kp N2 &kp N3 &kp N4 &kp N5     &none &none &none &none &none &none
   &kp KP_ENTER &kp N6 &kp N7 &kp N8 &kp N9 &kp N0     &none &none &none &none &none &kp GLOBE
              &none &none &tog L_NUM     &kp BSPC &kp SPACE &none
                        >;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
   &none &none &none &none &none &none     &kp QMARK &kp PLUS &kp MINUS &kp DOT &kp FSLH &kp BSLH
   &none &none &none &none &none &none     &kp AMPS &kp LT &kp EQUAL &kp GT &kp PIPE &kp HASH
   &kp GLOBE &none &none &none &none &none         &kp LBKT &kp LPAR &kp COLON &kp RPAR &kp RBKT &kp PRCNT
              &none &none &tog L_SYM     &kp AT &kp SPACE &none
                        >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
   &none &none &none &none &none &none     &none &none &none &none &none &none
   &kp C_VOL_UP &kp C_BRI_UP &none &none &none &none     &none &none &none &none &none &none
   &kp C_VOL_DN &kp C_BRI_DN &kp C_PREV &kp C_PP &kp C_NEXT &none     &none &none &none &none &none &kp GLOBE
              &none &none &tog L_MED     &none &kp C_STOP &none
                        >;
        };

        function_layer {
            display-name = "Functions";
            bindings = <
   &none &kp F16 &kp F17 &kp F18 &kp F19 &kp F20     &none &none &none &none &none &none
   &none &kp F11 &kp F12 &kp F13 &kp F14 &kp F15     &none &none &none &none &none &none
   &none &kp F6 &kp F7 &kp F8 &kp F9 &kp F10         &none &none &none &none &none &kp GLOBE
              &none &none &tog L_FUN     &none &none &none
                        >;
        };

        button_layer {
            display-name = "Buttons";
            bindings = <
   &none &kp BTAB &kp TAB &none &kp TAB &none     &none &none &none &none &none &none
   &none &kp LG(TAB) &kp LG(W) &kp TAB &kp LG(TAB) &none     &none &none &none &none &none &none
   &none &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &none     &none &none &none &none &none &none
              &none &none &tog L_BUT     &none &none &none
                        >;
        };

        system_layer {
            display-name = "System";
            bindings = <
   &none &none &none &none &none &none     &none &none &none &none &none &none
   &bootloader &none &none &none &none &none     &none &none &none &none &none &none
   &sys_reset &none &none &none &none &none     &none &none &none &none &none &none
              &none &none &tog L_SYS     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_CLR
                        >;
        };
    };
};
